{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l4/outcome@1",
  "title": "l4 outcome",
  "description": "Written to .l4-out/outcome.json by run, verify, archive and plan (SPEC L4-CLI-002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "harness_version", "exit_code", "units"],
  "properties": {
    "schema": {"enum": ["l4/outcome@1"]},
    "run_id": {"type": "string", "pattern": "^r-[0-9]{8}T[0-9]{4}Z-[0-9a-f]{4}$"},
    "harness_version": {"type": "string"},
    "harness_commit": {"type": ["string", "null"]},
    "exit_code": {"enum": [0, 1, 2, 3, 10, 11, 12, 13, 14]},
    "continuation": {"enum": ["dispatched", "already_queued", "unsupported"]},
    "relay": {"enum": ["dispatched", "already_running", "no_work", "on_base", "refused", "unsupported", "failed"]},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit", "phase_before", "phase_after"],
        "properties": {
          "unit": {"type": "string", "pattern": "^(openspec|kiro):[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "phase_before": {"type": "string"},
          "phase_after": {"type": "string"},
          "tasks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"done": {"type": "integer"}, "total": {"type": "integer"}}
          },
          "open_questions": {"type": "array", "items": {"type": "string"}},
          "verdict": {"type": ["string", "null"]},
          "profiles": {"type": "object"},
          "cost_usd": {"type": ["number", "null"]},
          "iteration": {"type": "integer"},
          "pr_url": {"type": ["string", "null"]},
          "retry_after": {"type": ["string", "null"]},
          "continuation": {"enum": ["not_needed", "dispatched", "failed"]},
          "exit_reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
