     "criterion": {
      "type": "string",
      "enum": [
       "outcome", "testability", "interfaces", "failure_cases", "feasibility", "duplicate_scope", "contradiction",
       "missing_dependency", "batch_acceptance"
      ]
     },
     "severity": {"type": "string", "enum": ["blocking", "major", "minor"]},
     "text": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
   }
  },
  "assumptions": {"type": "array", "items": {"type": "string", "maxLength": 1000}},
  "missing": {"type": "array", "items": {"type": "string", "maxLength": 1000}}
 }
}
