  "findings": [
    {
      "severity": "minor",
      "title": "A negative half cent rounds toward +infinity, not away from zero",
      "detail": "For negative products, floor division plus 50 rounds a half toward positive infinity. tip_cents(-1005, 10) gives (-10050 + 50)//100 = -100, but rounding half away from zero would give -101. The spec says 'rounded half up' and only pins down positive inputs. The code also does not reject negative totals or percents.",
      "source": "judge",
      "criterion": "C-c0f2ea95",
      "log": null,
      "spec_gap": true,
      "suggested_fix": "WHEN the checkout calls `pricing.tips.tip_cents(-1005, 10)` THEN it returns `-100` (a negative half cent rounds toward positive infinity and negative inputs are not rejected).",
      "id": "F-3b8ca534"
    }
