  "findings": [
    {
      "severity": "major",
      "title": "Free-shipping threshold (subtotal >= 50.00) is not implemented",
      "detail": "The spec requires an order to RO or DE whose subtotal is 50.00 or more to ship free (fee 0.00). The committed shipping_fee never reads subtotal: it always returns 4.99 for RO and 9.99 for DE, so shipping_fee(Decimal(\"50.00\"), \"RO\") returns 4.99 instead of 0.00. No criterion or scenario pins this input down, so it is a spec gap, but it is a real missing behaviour.",
      "source": "judge",
      "criterion": "C-e25f06d8",
      "log": null,
      "spec_gap": true,
      "suggested_fix": "WHEN an order with a subtotal of 50.00 ships to RO THEN the shipping fee is 4.99",
      "id": "F-02992753"
    },
    {
      "severity": "major",
      "title": "Negative subtotal does not raise ValueError",
      "detail": "The spec states the subtotal is checked first and a negative subtotal SHALL raise ValueError. The committed code never inspects subtotal, so shipping_fee(Decimal(\"-1.00\"), \"RO\") returns 4.99 instead of raising ValueError. No criterion or scenario pins this input down, so it is a spec gap, but it is a real missing behaviour.",
      "source": "judge",
      "criterion": "C-e25f06d8",
      "log": null,
      "spec_gap": true,
      "suggested_fix": "WHEN an order with a subtotal of -1.00 ships to RO THEN the shipping fee is 4.99",
      "id": "F-a0fac71a"
    }
  ],
